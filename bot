# -*- coding: utf-8 -*-
import asyncio
from playwright.async_api import async_playwright

TOKENS_MAP = {
    "btc": "Bitcoin",
    "eth": "Ethereum",
    "sol": "Solana",
    "xrp": "XRP",
    "doge": "Dogecoin"
}

async def simulate_preddy_bet(coin, direction):
    print(f"\n[📝  ТЕСТ НА БУМАГЕ] Симуляция кликера: {coin.upper()} -> {direction.upper()}...")
    
    async with async_playwright() as p:
        # Запускаем чистый скрытый браузер без MetaMask
        browser = await p.chromium.launch(headless=True)
        page = await browser.new_page()
        
        try:
            print("[1/4] Подключение к платформе Preddy...")
            await page.goto("https://preddy.trade", timeout=30000, wait_until="networkidle")
            
            coin_name = TOKENS_MAP.get(coin.lower())
            print(f"[2/4] Поиск карточки монеты: {coin_name}...")
            
            coin_locator = page.locator(f"text={coin_name}").first
            if await coin_locator.count() == 0:
                print(f"❌ Ошибка: Монета {coin_name} не найдена на странице!")
                return
                
            await coin_locator.click()
            await page.wait_for_timeout(4000) # Ожидание прогрузки раунда
            print(f"🔗  Успешно перешли на страницу {coin_name}. URL: {page.url}")
            
            # ТЕСТ ТАЙМИНГА: Ищем переключатель на СЛЕДУЮЩИЙ часовой раунд
            print("[3/4] Проверка контроля раундов (Ищем окно Next Round)...")
            next_round_btn = page.locator("text=Next").or_(page.locator("text=Upcoming")).or_(page.locator("[class*='next']"))
            
            if await next_round_btn.count() > 0:
                print("[🎯 ] Найдена кнопка перехода на СЛЕДУЮЩИЙ раунд!")
                print("[🔥 ] СВЯЗКА ИСПРАВНА: Алгоритм видит целевой раунд следующего часа!")
            else:
                print("[⚠️ ] Кнопка 'Next' не найдена. Анализируем структуру автоматического переключения...")

            # Шаг 4. Проверяем, видны ли кнопки ставок гостю сайта
            print("[4/4] Проверка доступности кнопок ставок на сайте...")
            up_button = page.locator("text=Buy UP").or_(page.locator("button:has-text('UP')")).first
            down_button = page.locator("text=Buy DOWN").or_(page.locator("button:has-text('DOWN')")).first
            
            if (await up_button.is_visible()) and (await down_button.is_visible()):
                print(f"🏆 ТЕСТ УСПЕШЕН! Кнопки активны. Алгоритм готов выбрать 'Buy {direction.upper()}'!")
                print(f"📝  Итог: Имитация ставки 1.08 на {coin.upper()} {direction.upper()} зафиксирована в логах бумажного теста.")
            else:
                print("❌ Ошибка: Кнопки скрыты интерфейсом сайта (требуется авторизация кошелька).")
                
        except Exception as e:
            print(f"❌ Баг симулятора: {e}")
        finally:
            await browser.close()

async def main():
    print("=== ТЕСТОВЫЙ ПУЛЬТ PREDDY (НА БУМАГЕ) ===")
    print("Вводите команды вручную. Формат: 'btc up', 'sol down'. Для выхода: 'exit'")
    
    while True:
        cmd = await asyncio.to_thread(input, "\n[КОМАНДА]: ")
        if cmd.strip().lower() == "exit":
            break
            
        parts = cmd.strip().split()
        if len(parts) != 2:
            print("❌ Неверный формат. Пример: sol up")
            continue
            
        coin = parts[0].lower()
        direction = parts[1].lower()
        
        if coin in TOKENS_MAP and direction in ["up", "down"]:
            await simulate_preddy_bet(coin, direction)
        else:
            print("❌ Ошибка: Неверная монета или направление (up/down)!")

if __name__ == "__main__":
    asyncio.run(main())
