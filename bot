# -*- coding: utf-8 -*-
import asyncio
from playwright.async_api import async_playwright

USER_DATA_DIR = "/root/PreddyProfile"
EXTENSION_PATH = "/root/PreddyProfile/Default/Extensions/nkbihfbeogaeaoehlefnkodbefgpgknn"

TOKENS_MAP = {
    "btc": "Bitcoin",
    "eth": "Ethereum",
    "sol": "Solana",
    "xrp": "XRP",
    "doge": "Dogecoin"
}

URL_MAP = {
    "btc": "https://preddy.trade",
    "eth": "https://preddy.trade",
    "sol": "https://preddy.trade",
    "xrp": "https://preddy.trade",
    "doge": "https://preddy.trade"
}

async def simulate_authorized_bet(coin, direction):
    print(f"\n[📝  АВТОРИЗОВАННЫЙ ТЕСТ] Имитация кликера: {coin.upper()} -> {direction.upper()}...")
    
    async with async_playwright() as p:
        context = await p.chromium.launch_persistent_context(
            user_data_dir=USER_DATA_DIR,
            headless=True,
            viewport={"width": 1920, "height": 1080},
            args=[
                f"--disable-extensions-except={EXTENSION_PATH}",
                f"--load-extension={EXTENSION_PATH}"
            ]
        )
        
        page = await context.new_page()
        
        try:
            # СТАБИЛИЗАЦИЯ: Ждем только загрузку DOM, убираем долгий networkidle
            print("[1/4] Скоростная авторизация сессии MetaMask...")
            await page.goto("https://preddy.trade", timeout=20000, wait_until="domcontentloaded")
            await page.wait_for_timeout(3000)
            
            coin_name = TOKENS_MAP.get(coin.lower())
            target_url = URL_MAP.get(coin.lower())
            print(f"[2/4] Прорыв напрямую в часовой хаб {coin_name}...")
            await page.goto(target_url, timeout=20000, wait_until="domcontentloaded")
            await page.wait_for_timeout(3000)
            
            # ШАГ 3: Контроль таймингов и переключение на СЛЕДУЮЩИЙ ЧАС
            print("[3/4] Проверка контроля таймингов (Ищем Next Round)...")
            next_clicked = await page.evaluate("""() => {
                const elements = Array.from(document.querySelectorAll('button, span, div, a, p'));
                const nextEl = elements.find(el => {
                    const txt = el.textContent.toLowerCase();
                    return txt.includes('next') || txt.includes('upcoming') || txt.includes('следующий');
                });
                if (nextEl) {
                    nextEl.click();
                    return true;
                }
                return false;
            }""")
            
            if next_clicked:
                print("[🎯 ] Успешно переключились на раунд СЛЕДУЮЩЕГО часа!")
                await page.wait_for_timeout(2000)
            
            # ВЫВОД ТОЧНОГО ВРЕМЕНИ РАУНДА НА ЭКРАН
            # Бот ищет блоки, содержащие двоеточия или маркеры времени раунда
            round_time = await page.evaluate("""() => {
                const blocks = Array.from(document.querySelectorAll('div, p, span'));
                // Ищем строку, где есть тире между часами, например "18:00 - 19:00" или "PM"
                const timeBlock = blocks.find(b => {
                    const t = b.textContent;
                    return (t.includes(':') && t.includes('-')) || t.includes('UTC');
                });
                return timeBlock ? timeBlock.textContent.trim() : 'Время раунда не определено интерфейсом';
            }""")
            print(f"⏰ ЦЕЛЕВОЙ ПЕРИОД НА САЙТЕ: {round_time}")

            # Шаг 4. Анализ доступности интерфейса ставок
            print("[4/4] Анализ доступности интерфейса ставок под вашим аккаунтом...")
            up_button = page.locator("text=Buy UP").or_(page.locator("button:has-text('UP')")).first
            down_button = page.locator("text=Buy DOWN").or_(page.locator("button:has-text('DOWN')")).first
            
            if (await up_button.is_visible()) or (await down_button.is_visible()):
                print(f"🏆 ПОЛНЫЙ ТРИУМФ! Интерфейс ставок полностью готов!")
                print(f"📝  Итог: Скрипт готов отправить ваши $1.08 на 'Buy {direction.upper()}' строго на указанный выше час.")
                print("🔒 Симуляция завершена успешно. Баланс кошелька в безопасности.")
            else:
                print("❌ Ошибка: Кнопки ставок скрыты версткой.")
                
        except Exception as e:
            print(f"❌ Критический баг симулятора: {e}")
        finally:
            await context.close()

async def main():
    print("=== ТЕСТОВЫЙ ПУЛЬТ PREDDY (АВТОРИЗОВАННАЯ БУМАГА) ===")
    print("Вводите команды вручную. Формат: 'btc up', 'sol down'. Для выхода: 'exit'")
    
    while True:
        cmd = await asyncio.to_thread(input, "\n[КОМАНДА СИМУЛЯЦИИ]: ")
        if cmd.strip().lower() == "exit":
            break
            
        parts = cmd.strip().split()
        if len(parts) != 2:
            print("❌ Неверный формат. Пример: sol up")
            continue
            
        coin = parts.lower()
        direction = parts.lower()
        
        if coin in TOKENS_MAP and direction in ["up", "down"]:
            await simulate_authorized_bet(coin, direction)
        else:
            print("❌ Ошибка: Неверная монета или направление!")

if __name__ == "__main__":
    asyncio.run(main())
