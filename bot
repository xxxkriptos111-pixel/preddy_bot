def send_log(message):
    """СНАЙПЕРСКИЙ САМОПИСЕЦ: Логирование в log.txt, консоль и Telegram"""
    timestamp = datetime.now(timezone(timedelta(hours=10))).strftime("%Y-%m-%d %H:%M:%S")
    clean_msg = message.replace("<b>", "").replace("</b>", "").replace("🟢 ", "").replace("🔴 ", "")
    
    with open("log.txt", "a", encoding="utf-8") as f:
        f.write(f"[{timestamp}] {clean_msg}\n")
        f.write("="*60 + "\n")
        
    print(f"[{timestamp}] {clean_msg}")
    
    try:
        url = f"https://telegram.org{TG_TOKEN}/sendMessage"
        payload = {"chat_id": TG_CHAT_ID, "text": message, "parse_mode": "HTML"}
        requests.post(url, json=payload, timeout=1.0)
    except:
        pass

def check_vladivostok_session():
    """ЭШЕЛОН 1: Контроль золотых окон времени Владивостока (GMT+10)"""
    vlad_time = datetime.now(timezone(timedelta(hours=10)))
    total_min = vlad_time.hour * 60 + vlad_time.minute
    
    if 600 <= total_min <= 1020: 
        return True, "🌅  ASIA_FLAT (Тихий боковик)"
    if (22 * 60 + 30) <= total_min or total_min <= (0 * 60 + 30): 
        return True, "🇺🇸  РАЗОГРЕВ АМЕРИКИ (Импульс китов)"
    if 300 <= total_min <= 420: 
        return True, "🇺🇸  ЗАТИШЬЕ АМЕРИКИ (Финал плит)"
    return False, "SKIP"

def get_market_data(ticker):
    """ОРАКУЛ BYBIT V5: Чистый съем котировок в целых числах 50/50"""
    try:
        symbol = CLONES_MATRIX[ticker]["symbol"]
        res = bybit_session.get_tickers(category="linear", symbol=symbol)
        if "result" in res and "list" in res["result"] and len(res["result"]["list"]) > 0:
            raw_list = res["result"]["list"]
            first_element = raw_list.pop(0)
            live_p = float(first_element["lastPrice"])
            
            _time = bybit_session.get_server_time()
            server_ts = int(_time["result"]["timeSecond"])
            current_min = datetime.fromtimestamp(server_ts, timezone.utc).minute
            
            if current_min <= 1 or ticker not in LOCAL_STRIKES_CACHE:
                LOCAL_STRIKES_CACHE[ticker] = live_p
                
            strike = LOCAL_STRIKES_CACHE[ticker]
            diff = ((live_p - strike) / strike) * 100.0
            yes_p = round(0.50 + (diff * 7.5), 2)
            if yes_p < 0.05: yes_p = 0.05
            if yes_p > 0.95: yes_p = 0.95
            
            yes_display = int(yes_p * 100)
            return yes_display, 100 - yes_display, live_p, current_min, True
        return 50, 50, 0.0, 0, False
    except:
        return 50, 50, 0.0, 0, False
