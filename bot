def send_telegram_alert(message):
    """БРОНИРОВАННЫЙ АВТОНОМНЫЙ ШЛЮЗ: Запись в log.txt + Telegram"""
    try:
        clean_text = message.replace("<b>", "").replace("</b>", "").replace("<code>", "").replace("</code>", "")
        clean_text = clean_text.replace("**", "").replace("`", "")
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        
        with open("log.txt", "a", encoding="utf-8") as f:
            f.write(f"[{timestamp}] {clean_text}\n")
            f.write("="*50 + "\n")
        
        try:
            url = f"https://telegram.org{TG_TOKEN}/sendMessage"
            payload = {"chat_id": TG_CHAT_ID, "text": message, "parse_mode": "HTML"}
            requests.post(url, json=payload, timeout=1.0)
        except:
            pass
    except Exception as e:
        print(f"🚨  [СБОЙ САМОПИСЦА]: {e}")

