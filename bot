POLYMARKET_TOKENS = list(CONFIG_MATRIX.keys())
current_preddy_balance = VIRTUAL_PREDDY_CASH
current_bybit_balance = VIRTUAL_BYBIT_CASH

def update_balances():
    global current_preddy_balance, current_bybit_balance
    preddy_profit = 0.0
    bybit_profit = 0.0
    for pos_id, data in active_positions.items():
        if data["stage"] == "PREDDY_LOCK_PROFIT":
            preddy_profit += data["lot_size"] * 0.6666  
        elif data["stage"] == "BYBIT_HEDGED_PROFIT":
            bybit_profit += data["lot_size"] * 0.120    
    current_preddy_balance = VIRTUAL_PREDDY_CASH + preddy_profit
    current_bybit_balance = VIRTUAL_BYBIT_CASH + bybit_profit

LOCAL_STRIKES_CACHE = {}

def get_market_price_direct(ticker):
    try:
        bybit_symbol = CONFIG_MATRIX[ticker]["symbol"]
        response = bybit_session.get_tickers(category="linear", symbol=bybit_symbol)
        
        if "result" in response and "list" in response["result"] and len(response["result"]["list"]) > 0:
            live_price = float(response["result"]["list"]["lastPrice"])
            _time_res = bybit_session.get_server_time()
            _server_ts = int(_time_res["result"]["timeSecond"])
            current_minute = datetime.fromtimestamp(_server_ts, timezone.utc).minute
            
            if current_minute <= 1 or ticker not in LOCAL_STRIKES_CACHE:
                LOCAL_STRIKES_CACHE[ticker] = live_price
                
            strike = LOCAL_STRIKES_CACHE[ticker]
            diff_pct = ((live_price - strike) / strike) * 100.0
            yes_price = round(0.50 + (diff_pct * 7.5), 2)
            
            if yes_price < 0.05: yes_price = 0.05
            if yes_price > 0.95: yes_price = 0.95
            
            return yes_price, round(1.0 - yes_price, 2), live_price, True
        return 0.51, 0.49, 0.0, False
    except:
        return 0.51, 0.49, 0.0, False

def execute_blockchain_order(market_slug, outcome, amount):
    yes_p, no_p, live_p, success = get_market_price_direct(market_slug)
    target_p = yes_p if outcome == "yes" else no_p
    alert_msg = (
        f"🔔  <b>[ВЕРИФИЦИРОВАННЫЙ СИГНАЛ]</b>\n\n"
        f"📦 Рынок: {market_slug.upper()}\n"
        f"🎯  Направление ордера: {outcome.upper()}\n"
        f"💵  Цена контракта: {target_p} USD (Триггер сработал!)\n"
        f"📊  Текущий спот Bybit: {live_p}\n"
        f"💰 Объем лота: {amount} USD\n"
        f"🛡️  Шлюз: Прокси-Оракул Bybit V5"
    )
    send_telegram_alert(alert_msg)
    print(f"🔥  [BYBIT SDK] Симуляция ордера: {outcome.upper()} на сумму {amount} USD")
    return True
