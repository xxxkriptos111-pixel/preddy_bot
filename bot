# -*- coding: utf-8 -*-
import asyncio
from playwright.async_api import async_playwright

TOKENS_MAP = {
    "btc": "BTC",
    "eth": "ETH",
    "sol": "SOL",
    "xrp": "XRP",
    "doge": "DOGE"
}

async def simulate_preddy_bet(coin, direction):
    print(f"\n[📝  ТЕСТ НА БУМАГЕ] Имитация кликера: {coin.upper()} -> {direction.upper()}...")
    
    async with async_playwright() as p:
        browser = await p.chromium.launch(headless=True)
        page = await browser.new_page()
        
        try:
            print("[1/4] Подключение к главной странице Preddy...")
            await page.goto("https://preddy.trade", timeout=30000, wait_until="networkidle")
            
            # Шаг 2. Кликаем по категории Crypto, чтобы раскрыть список монет
            print("[2/4] Переход в раздел макро-категории Crypto...")
            crypto_tab = page.locator("text=Crypto").first
            await crypto_tab.click()
            await page.wait_for_timeout(3000)
            
            # Теперь ищем конкретный тикер (BTC, SOL, XRP)
            coin_ticker = TOKENS_MAP.get(coin.lower())
            print(f"🔎  Ищем плашку монеты в стакане: {coin_ticker}...")
            
            coin_locator = page.locator(f"text={coin_ticker}").first
            if await coin_locator.count() == 0:
                print(f"❌ Ошибка: Кнопка {coin_ticker} не найдена в интерфейсе!")
                return
                
            await coin_locator.click()
            await page.wait_for_timeout(4000) # Даем загрузиться раундам
            print(f"🔗  Успешно зашли внутрь раундов! Текущий URL: {page.url}")
            
            # Шаг 3. Ищем переключатель на СЛЕДУЮЩИЙ часовой раунд
            print("[3/4] Проверка контроля таймингов (Ищем Next Round)...")
            next_round_btn = page.locator("text=Next").or_(page.locator("text=Upcoming")).first
            
            if await next_round_btn.count() > 0:
                print("[🎯 ] Найдена кнопка перехода на СЛЕДУЮЩИЙ раунд! Имитируем клик...")
                await next_round_btn.click()
                await page.wait_for_timeout(2000)
                print("[🔥 ] СВЯЗКА ИСПРАВНА: Выбран раунд следующего часа!")
            else:
                print("[⚠️ ] Кнопка 'Next' не найдена. Возможно, интерфейс отображает раунды списком.")

            # Шаг 4. Проверяем доступность кнопок для гостя
            print("[4/4] Анализ доступности интерфейса ставок...")
            up_button = page.locator("text=Buy UP").or_(page.locator("button:has-text('UP')")).first
            down_button = page.locator("text=Buy DOWN").or_(page.locator("button:has-text('DOWN')")).first
            
            if (await up_button.is_visible()) and (await down_button.is_visible()):
                print(f"🏆 ТЕСТ НА БУМАГЕ ПРОЙДЕН! Кнопки активны. Скрипт готов выбрать 'Buy {direction.upper()}'!")
            else:
                print("❌ Ошибка интерфейса: Кнопки ставок скрыты (требуется подключение MetaMask).")
                
        except Exception as e:
            print(f"❌ Баг симулятора: {e}")
        finally:
            await browser.close()

async def main():
    print("=== ТЕСТОВЫЙ ПУЛЬТ PREDDY (НА БУМАГЕ) ===")
    print("Вводите команды вручную. Формат: 'btc up', 'sol down'. Для выхода: 'exit'")
    
    while True:
        cmd = await asyncio.to_thread(input, "\n[КОМАНДА]: ")
        if cmd.strip().lower() == "exit":
            break
            
        parts = cmd.strip().split()
        if len(parts) != 2:
            print("❌ Неверный формат. Пример: sol up")
            continue
            
        coin = parts[0].lower()
        direction = parts[1].lower()
        
        if coin in TOKENS_MAP and direction in ["up", "down"]:
            await simulate_preddy_bet(coin, direction)
        else:
            print("❌ Ошибка: Неверная монета или направление!")

if __name__ == "__main__":
    asyncio.run(main())
