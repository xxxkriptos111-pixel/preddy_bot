# -*- coding: utf-8 -*-
import asyncio
from playwright.async_api import async_playwright

TOKENS_MAP = {
    "btc": "BTC",
    "eth": "ETH",
    "sol": "SOL",
    "xrp": "XRP",
    "doge": "DOGE"
}

async def simulate_preddy_bet(coin, direction):
    print(f"\n[📝  ТЕСТ НА БУМАГЕ] Имитация кликера: {coin.upper()} -> {direction.upper()}...")
    
    async with async_playwright() as p:
        # УСТАНАВЛИВАЕМ РАЗРЕШЕНИЕ ЭКРАНА FULL HD (1920x1080)
        browser = await p.chromium.launch(headless=True)
        page = await browser.new_page(viewport={"width": 1920, "height": 1080})
        
        try:
            print("[1/4] Подключение к главной странице Preddy...")
            await page.goto("https://preddy.trade", timeout=30000, wait_until="networkidle")
            await page.wait_for_timeout(3000)
            
            # Шаг 2. Кликаем по категории Crypto через JavaScript (игнорирует viewport!)
            print("[2/4] Переход в раздел макро-категории Crypto...")
            
            # Находим элемент с текстом Crypto и кликаем по нему напрямую через JS-код страницы
            await page.evaluate("""() => {
                const elements = Array.from(document.querySelectorAll('span, button, a'));
                const cryptoEl = elements.find(el => el.textContent.trim() === 'Crypto');
                if (cryptoEl) cryptoEl.click();
                else throw new Error('Элемент Crypto не найден в DOM');
            }""")
            
            await page.wait_for_timeout(3000)
            
            # Теперь ищем и кликаем конкретный тикер (BTC, SOL, XRP) тоже через JS
            coin_ticker = TOKENS_MAP.get(coin.lower())
            print(f"🔎  Ищем и активируем плашку монеты в DOM: {coin_ticker}...")
            
            await page.evaluate(f"""() => {{
                const elements = Array.from(document.querySelectorAll('span, button, a, div'));
                const coinEl = elements.find(el => el.textContent.trim() === '{coin_ticker}');
                if (coinEl) coinEl.click();
                else throw new Error('Тикер {coin_ticker} не найден в DOM');
            }}""")
            
            await page.wait_for_timeout(5000) # Даем загрузиться раундам
            print(f"🔗  УСПЕХ! Мы пробили интерфейс сайта. Текущий URL: {page.url}")
            
            # Шаг 3. Ищем переключатель на СЛЕДУЮЩИЙ часовой раунд
            print("[3/4] Проверка контроля таймингов (Ищем Next Round)...")
            
            # Кликаем на кнопку Next/Upcoming через JS
            next_clicked = await page.evaluate("""() => {
                const elements = Array.from(document.querySelectorAll('button, span, div'));
                const nextEl = elements.find(el => el.textContent.trim() === 'Next' || el.textContent.trim() === 'Upcoming');
                if (nextEl) {
                    nextEl.click();
                    return true;
                }
                return false;
            }""")
            
            if next_clicked:
                print("[🔥 ] СВЯЗКА ИСПРАВНА: Переключились на раунд следующего часа!")
                await page.wait_for_timeout(2000)
            else:
                print("[⚠️ ] Кнопка 'Next' не найдена. Возможно, интерфейс отображает раунды списком.")

            # Шаг 4. Анализируем доступность кнопок
            print("[4/4] Анализ доступности интерфейса ставок...")
            up_button = page.locator("text=Buy UP").or_(page.locator("button:has-text('UP')")).first
            down_button = page.locator("text=Buy DOWN").or_(page.locator("button:has-text('DOWN')")).first
            
            if (await up_button.is_visible()) and (await down_button.is_visible()):
                print(f"🏆 ТЕСТ НА БУМАГЕ ПОЛНОСТЬЮ ПРОЙДЕН! Скрипт готов выбрать 'Buy {direction.upper()}'!")
            else:
                print("❌ Ошибка интерфейса: Кнопки ставок скрыты (требуется подключение кошелька).")
                
        except Exception as e:
            print(f"❌ Критический баг симулятора: {e}")
        finally:
            await browser.close()

async def main():
    print("=== ТЕСТОВЫЙ ПУЛЬТ PREDDY (НА БУМАГЕ) ===")
    print("Вводите команды вручную. Формат: 'btc up', 'sol down'. Для выхода: 'exit'")
    
    while True:
        cmd = await asyncio.to_thread(input, "\n[КОМАНДА]: ")
        if cmd.strip().lower() == "exit":
            break
            
        parts = cmd.strip().split()
        if len(parts) != 2:
            print("❌ Неверный формат. Пример: sol up")
            continue
            
        coin = parts[0].lower()
        direction = parts[1].lower()
        
        if coin in TOKENS_MAP and direction in ["up", "down"]:
            await simulate_preddy_bet(coin, direction)
        else:
            print("❌ Ошибка: Неверная монета или направление!")

if __name__ == "__main__":
    asyncio.run(main())
