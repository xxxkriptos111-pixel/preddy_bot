def send_log(message):
    try:
        timestamp = datetime.now(timezone(timedelta(hours=10))).strftime("%Y-%m-%d %H:%M:%S")
        clean_msg = message.replace("<b>", "").replace("</b>", "").replace("<code>", "").replace("</code>", "")
        with open("log.txt", "a", encoding="utf-8") as f:
            f.write(f"[{timestamp}] {clean_msg}\n============================================================\n")
        print(f"[{timestamp}] {clean_msg}")
        url = f"https://telegram.org{TG_TOKEN}/sendMessage"
        requests.post(url, json={"chat_id": TG_CHAT_ID, "text": message, "parse_mode": "HTML"}, timeout=1.0)
    except:
        pass

def check_vladivostok_session():
    vlad_time = datetime.now(timezone(timedelta(hours=10)))
    total_min = vlad_time.hour * 60 + vlad_time.minute
    if 600 <= total_min <= 1020: return True, "🌅  ASIA_FLAT (Тихий боковик)"
    if (22 * 60 + 30) <= total_min or total_min <= (0 * 60 + 30): return True, "🇺🇸  РАЗОГРЕВ АМЕРИКИ"
    if 300 <= total_min <= 420: return True, "🇺🇸  ЗАТИШЬЕ АМЕРИКИ"
    return False, "SKIP"

def get_bybit_candle_anatomy(ticker):
    """ОРАКУЛ: Ювелирный геометрический разбор закрытой свечи Bybit V5"""
    try:
        symbol = CLONES_MATRIX[ticker]["symbol"]
        res = bybit_session.get_kline(category="linear", symbol=symbol, interval="60", limit=3)
        if "result" in res and "list" in res["result"] and len(res["result"]["list"]) > 1:
            # Индекс 1 — это гарантированно прошлый, ПОЛНОСТЬЮ закрытый часовой бар
            target_candle = res["result"]["list"][1]
            
            open_p  = float(target_candle[1])
            high_p  = float(target_candle[2])
            low_p   = float(target_candle[3])
            close_p = float(target_candle[4])
            
            total_height = high_p - low_p
            if total_height == 0: total_height = 0.00001
            
            if close_p >= open_p:
                body_size = close_p - open_p
                upper_wick = high_p - close_p
                lower_wick = open_p - low_p
                direction = "GREEN"
            else:
                body_size = open_p - close_p
                upper_wick = high_p - open_p
                lower_wick = close_p - low_p
                direction = "RED"
                
            body_pct = int((body_size / total_height) * 100)
            up_wick_pct = int((upper_wick / total_height) * 100)
            down_wick_pct = int((lower_wick / total_height) * 100)
            
            _time = bybit_session.get_server_time()
            current_min = datetime.fromtimestamp(int(_time["result"]["timeSecond"]), timezone.utc).minute
            
            return direction, body_pct, up_wick_pct, down_wick_pct, close_p, current_min, True
        return "NEUTRAL", 0, 0, 0, 0.0, 0, False
    except:
        return "NEUTRAL", 0, 0, 0, 0.0, 0, False
