        symbol = CLONES_MATRIX[ticker]["symbol"]
        # Запрашиваем 3 последние часовые свечи Bybit для глубокого анализа структуры
        res = bybit_session.get_kline(category="linear", symbol=symbol, interval="60", limit=3)
        if "result" in res and "list" in res["result"] and len(res["result"]["list"]) > 1:
            kline_list = res["result"]["list"]
            
            # Свеча [0] - текущая живая (55-я минута), Свеча [1] - прошлый закрытый час, Свеча [2] - позапрошлый час
            curr_c = kline_list[0]
            prev_c = kline_list[1]
            old_c  = kline_list[2]
            
            # Цены текущего часа
            c_open, c_high, c_low, c_live = float(curr_c[1]), float(curr_c[2]), float(curr_c[3]), float(curr_c[4])
            # Цены прошлого часа
            p_open, p_high, p_low, p_close = float(prev_c[1]), float(prev_c[2]), float(prev_c[3]), float(prev_c[4])
            # Цены позапрошлого часа
            o_open, o_high, o_low, o_close = float(old_c[1]), float(old_c[2]), float(old_c[3]), float(old_c[4])
            
            _time = bybit_session.get_server_time()
            current_min = datetime.fromtimestamp(int(_time["result"]["timeSecond"]), timezone.utc).minute
            
            # Направление текущего живого закрытия (для подведения итогов)
            live_direction = "GREEN" if c_live >= c_open else "RED"
            
            # -----------------------------------------------------------------
            # МАТЕМАТИКА ПАТТЕРНОВ ЕВГЕНИЯ (Поиск на 55-й минуте)
            # -----------------------------------------------------------------
            pattern_found = None
            reason = ""
            
            # ПАТТЕРН 1: MSB + Ретест уровня (Пробой хая/лоу прошлого часа и возврат к нему)
            if p_close > p_open and c_live < c_high and c_live <= p_high and c_live >= p_close:
                # Розовая свеча ретестит сверху вниз пробитый уровень хая/закрытия прошлого часа
                pattern_found = "🟢  ЗЕЛЕНАЯ"
                reason = f"Обнаружен Слом Структуры (MSB) и Ретест уровня! Прошлый час пробил плиту вверх ({p_high}). Текущая свеча скорректировалась вниз, протестировала уровень поддержки ({c_live}) и удержалась над ним. Ожидается мощный отскок вверх по тренду!"
            
            elif p_close < p_open and c_live > c_low and c_live >= p_low and c_live <= p_close:
                # Голубая свеча ретестит снизу вверх уровень поддержки прошлого часа
                pattern_found = "🔴  КРАСНАЯ"
                reason = f"Обнаружен Слом Структуры (MSB) и Ретест уровня! Прошлый час продавил плиту вниз ({p_low}). Текущая свеча скорректировалась наверх к уровню сопротивления ({c_live}) и уперлась в него. Ожидается падение вниз по тренду!"
            
            # ПАТТЕРН 2: Импульсное Свечное Поглощение (Engulfing)
            if not pattern_found:
                p_body = abs(p_close - p_open)
                c_body = abs(c_live - c_open)
                
                if c_live > c_open and p_close < p_open and c_body > p_body and c_live > p_open:
                    pattern_found = "🟢  ЗЕЛЕНАЯ"
                    reason = f"Обнаружено Импульсное Поглощение! Текущее голубое тело свечи ({c_body}) полностью перекрыло и сожрало розовое тело прошлого часа ({p_body}). Сила покупателей доминирует, киты гонят импульс вверх!"
                elif c_live < c_open and p_close > p_open and c_body > p_body and c_live < p_open:
                    pattern_found = "🔴  КРАСНАЯ"
                    reason = f"Обнаружено Импульсное Поглощение! Текущее розовое тело свечи ({c_body}) полностью поглотило и перекрыло голубое тело прошлого часа ({p_body}). Медведи выбивают покупателей, тренд летит вниз!"
            
            return live_direction, pattern_found, reason, c_live, current_min, True
        return "NEUTRAL", None, "", 0.0, 0, False
    except:
        return "NEUTRAL", None, "", 0.0, 0, False
